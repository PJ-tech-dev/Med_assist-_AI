# Required for all environments. Generate with a cryptographically secure password generator.
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development uses this value; Docker Compose overrides it for the MongoDB service.
MONGODB_URL=mongodb://localhost:27017/medassist

# Configure at least one LLM provider to enable AI responses.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
# Enable only when you deliberately need long-form model reasoning.
LLM_ENABLE_THINKING=false
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional emergency-message provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
